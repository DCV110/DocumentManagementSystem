<script>
// Check favorite status on page load
document.addEventListener('DOMContentLoaded', function() {
    const documentId = @document?.Id;
    if (documentId) {
        checkFavoriteStatus(documentId);
    }
});

function checkFavoriteStatus(documentId) {
    fetch('@Url.Action("IsFavorite", "Document")?documentId=' + documentId)
        .then(response => response.json())
        .then(data => {
            if (data.isFavorite) {
                updateFavoriteUI(true);
            }
        })
        .catch(err => console.error('Error checking favorite status:', err));
}

function updateFavoriteUI(isFavorite) {
    const icon = document.getElementById('favoriteIcon');
    const text = document.getElementById('favoriteText');
    
    if (isFavorite) {
        icon.textContent = 'favorite';
        icon.style.color = '#dc2626';
        text.textContent = 'Đã yêu thích';
    } else {
        icon.textContent = 'favorite_border';
        icon.style.color = '';
        text.textContent = 'Đánh dấu yêu thích';
    }
}

function toggleFavorite(documentId) {
    const icon = document.getElementById('favoriteIcon');
    const isCurrentlyFavorite = icon.textContent === 'favorite';
    
    // Get anti-forgery token
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    fetch('@Url.Action("ToggleFavorite", "Document")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || '',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ documentId: documentId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            updateFavoriteUI(data.isFavorite);
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(err => {
        console.error('Error toggling favorite:', err);
        alert('Có lỗi xảy ra khi cập nhật yêu thích');
    });
}

function shareDocument(documentId) {
    // TODO: Implement share functionality
    alert('Chức năng chia sẻ đang được phát triển');
}

// Rating functionality
document.addEventListener('DOMContentLoaded', function() {
    const documentId = @document?.Id;
    if (documentId) {
        loadRatingStats(documentId);
        loadUserRating(documentId);
        loadComments(documentId);
        
        // Setup star rating
        const stars = document.querySelectorAll('.star');
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                submitRating(documentId, rating);
            });
            
            star.addEventListener('mouseenter', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                highlightStars(rating);
            });
        });
        
        document.getElementById('starRating').addEventListener('mouseleave', function() {
            const currentRating = parseInt(document.getElementById('starRating').getAttribute('data-current-rating') || '0');
            highlightStars(currentRating);
        });
    }
});

function highlightStars(rating) {
    const stars = document.querySelectorAll('.star');
    stars.forEach((star, index) => {
        if (index < rating) {
            star.classList.add('active');
        } else {
            star.classList.remove('active');
        }
    });
}

function loadRatingStats(documentId) {
    fetch('@Url.Action("GetRatingStats", "Document")?documentId=' + documentId)
        .then(response => response.json())
        .then(data => {
            document.getElementById('ratingAverage').textContent = data.averageRating.toFixed(1);
            document.getElementById('ratingCount').textContent = `(${data.totalRatings} đánh giá)`;
            
            // Update star display with proper filling
            const avgRating = parseFloat(data.averageRating);
            const fullStars = Math.floor(avgRating);
            const hasHalfStar = (avgRating % 1) >= 0.5;
            
            const starWrappers = document.querySelectorAll('.rating-stars-display .star-wrapper');
            starWrappers.forEach((wrapper, index) => {
                let icon = wrapper.querySelector('.material-symbols-outlined');
                if (!icon) {
                    icon = document.createElement('span');
                    icon.className = 'material-symbols-outlined';
                    wrapper.appendChild(icon);
                }
                
                // Remove any existing half-border overlay
                const oldHalfBorder = wrapper.querySelector('.half-border-overlay');
                if (oldHalfBorder) oldHalfBorder.remove();
                
                if (index < fullStars) {
                    // Full star - filled
                    icon.textContent = 'star';
                    icon.classList.add('filled');
                    icon.classList.remove('half-filled');
                } else if (index === fullStars && hasHalfStar) {
                    // Half star - use filled star with border overlay
                    icon.textContent = 'star';
                    icon.classList.add('filled');
                    icon.classList.add('half-filled');
                    
                    // Add border overlay for the right half
                    const halfBorder = document.createElement('span');
                    halfBorder.className = 'material-symbols-outlined half-border-overlay';
                    halfBorder.textContent = 'star_border';
                    halfBorder.style.cssText = 'position: absolute; left: 0; top: 0; color: #d1d5db; clip-path: inset(0 0 0 50%); pointer-events: none;';
                    wrapper.appendChild(halfBorder);
                } else {
                    // Empty star - outline
                    icon.textContent = 'star_border';
                    icon.classList.remove('filled');
                    icon.classList.remove('half-filled');
                }
            });
        })
        .catch(err => console.error('Error loading rating stats:', err));
}

function loadUserRating(documentId) {
    fetch('@Url.Action("GetUserRating", "Document")?documentId=' + documentId)
        .then(response => response.json())
        .then(data => {
            if (data.rating > 0) {
                highlightStars(data.rating);
                document.getElementById('starRating').setAttribute('data-current-rating', data.rating);
            }
        })
        .catch(err => console.error('Error loading user rating:', err));
}

function submitRating(documentId, rating) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    fetch('@Url.Action("AddOrUpdateRating", "Document")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || '',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ documentId: documentId, rating: rating })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            highlightStars(rating);
            document.getElementById('starRating').setAttribute('data-current-rating', rating);
            loadRatingStats(documentId);
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(err => {
        console.error('Error submitting rating:', err);
        alert('Có lỗi xảy ra khi đánh giá');
    });
}

// Comments functionality
function loadComments(documentId) {
    fetch('@Url.Action("GetComments", "Document")?documentId=' + documentId)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const commentsList = document.getElementById('commentsList');
                commentsList.innerHTML = '';
                
                if (data.comments.length === 0) {
                    commentsList.innerHTML = '<p style="text-align: center; color: #6b7280; padding: 24px;">Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</p>';
                    return;
                }
                
                data.comments.forEach(comment => {
                    const commentDiv = document.createElement('div');
                    commentDiv.className = 'comment-item';
                    commentDiv.innerHTML = `
                        <div class="comment-header">
                            <span class="comment-author">${escapeHtml(comment.userName)}</span>
                            <span class="comment-date">${comment.createdDate}</span>
                        </div>
                        <div class="comment-content" id="comment-content-${comment.id}">${escapeHtml(comment.content)}</div>
                        ${comment.canEdit ? `
                            <div class="comment-actions">
                                <button class="comment-action-btn" onclick="editComment(${comment.id}, '${escapeHtml(comment.content)}')">Sửa</button>
                                <button class="comment-action-btn" onclick="deleteComment(${comment.id})">Xóa</button>
                            </div>
                        ` : ''}
                    `;
                    commentsList.appendChild(commentDiv);
                });
            }
        })
        .catch(err => console.error('Error loading comments:', err));
}

function addComment(documentId) {
    const content = document.getElementById('commentInput').value.trim();
    if (!content) {
        alert('Vui lòng nhập nội dung bình luận');
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    fetch('@Url.Action("AddComment", "Document")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || '',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ documentId: documentId, content: content })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('commentInput').value = '';
            loadComments(documentId);
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(err => {
        console.error('Error adding comment:', err);
        alert('Có lỗi xảy ra khi thêm bình luận');
    });
}

function editComment(commentId, currentContent) {
    const contentDiv = document.getElementById(`comment-content-${commentId}`);
    const commentItem = contentDiv.closest('.comment-item');
    
    const editForm = document.createElement('div');
    editForm.className = 'comment-edit-form';
    editForm.innerHTML = `
        <textarea id="edit-comment-${commentId}" rows="3">${escapeHtml(currentContent)}</textarea>
        <div class="comment-edit-actions">
            <button class="btn-primary" onclick="saveComment(${commentId})">Lưu</button>
            <button class="btn-secondary" onclick="cancelEdit(${commentId})">Hủy</button>
        </div>
    `;
    
    contentDiv.style.display = 'none';
    commentItem.appendChild(editForm);
}

function saveComment(commentId) {
    const content = document.getElementById(`edit-comment-${commentId}`).value.trim();
    if (!content) {
        alert('Nội dung bình luận không được để trống');
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    fetch('@Url.Action("UpdateComment", "Document")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || '',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ commentId: commentId, content: content })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const documentId = @document?.Id;
            loadComments(documentId);
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(err => {
        console.error('Error updating comment:', err);
        alert('Có lỗi xảy ra khi cập nhật bình luận');
    });
}

function cancelEdit(commentId) {
    const documentId = @document?.Id;
    loadComments(documentId);
}

function deleteComment(commentId) {
    if (!confirm('Bạn có chắc chắn muốn xóa bình luận này?')) {
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    fetch('@Url.Action("DeleteComment", "Document")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token || '',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ commentId: commentId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const documentId = @document?.Id;
            loadComments(documentId);
        } else {
            alert(data.message || 'Có lỗi xảy ra');
        }
    })
    .catch(err => {
        console.error('Error deleting comment:', err);
        alert('Có lỗi xảy ra khi xóa bình luận');
    });
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>

